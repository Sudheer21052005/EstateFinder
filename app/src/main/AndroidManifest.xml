<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed for the property REST API and Glide image loading -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- We hand the property location off to an external maps app via a geo: Intent.
         These <queries> make that app visible under Android 11+ package visibility. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EstateFinder">

        <!-- Phase 1 placeholders: real Splash/Home screens are built in Phase 2 -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EstateFinder.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.property.PropertyListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.details.PropertyDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.favorites.FavoritesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.map.MapPlaceholderActivity"
            android:exported="false" />
    </application>

</manifest>
